# APP_URL: Public base URL for QR, overlay, wallet, and review links.
APP_URL="http://localhost:3000"

# PERSISTENCE_DRIVER: Required before production business routes can mutate state.
# Current allowed development value is "memory".
PERSISTENCE_DRIVER="memory"

# DATABASE_URL: PostgreSQL connection used by Drizzle migrations and production persistence.
DATABASE_URL="postgres://sway:sway@localhost:5432/sway_tips"

# STRIPE_SECRET_KEY: Server-side Stripe API key. Use test keys locally and live keys only in production secrets.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Signing secret for /api/payment/webhook. Must match the Stripe endpoint mode.
STRIPE_WEBHOOK_SECRET=""
# Optional dedicated signing secret for `/api/payment/ticket-webhook`. Leave
# empty to verify native-ticket events on `/api/payment/webhook` with the shared
# Stripe webhook secret.
STRIPE_TICKET_WEBHOOK_SECRET=""

# Native ticket sales remain fail-closed unless every ticket setting below is valid.
# Enabling the flag creates automatic-capture platform charges and later explicit
# performer transfers; it does not reuse live-room destination charges.
SWAY_NATIVE_TICKETS_ENABLED="false"

# Production-only release approval. This must exactly match the current native
# ticket terms version after legal, finance, support, and production proof sign-off.
# Leave empty in development and while the production lane remains on HOLD.
SWAY_TICKET_PRODUCTION_APPROVAL_VERSION=""

# Mandatory Sway ticket fee. Both values are required before native sales can open.
# Every public price display uses face value + this fee prominently and says
# applicable government tax may still be added at checkout.
SWAY_TICKET_FEE_BPS=""
SWAY_TICKET_FEE_FIXED_CENTS=""

# Required tax posture:
# - stripe_automatic: Stripe Checkout calculates applicable ticket tax. Also set a
#   Stripe Tax product code appropriate for admission tickets.
# - not_required: use only after a qualified tax determination for the enabled sale.
SWAY_TICKET_TAX_MODE=""
SWAY_TICKET_STRIPE_TAX_CODE=""

# At least 32 unpredictable characters. Used only to sign rotating admission
# passes; never expose it to Vite/client variables.
SWAY_TICKET_QR_SECRET=""

# Comma-separated previous QR secrets used only during a controlled rotation.
# Retain an old secret until every ticket issued under it is no longer admissible
# or refundable, then remove it. Never expose these values to Vite/client code.
SWAY_TICKET_QR_PREVIOUS_SECRETS=""

# Required operational contact for ticket refunds, disputes, and admission
# problems. Native ticket sales stay closed unless this is a valid email.
SWAY_TICKET_SUPPORT_EMAIL=""

# Stripe-hosted Checkout requires 30 full minutes remaining at provider receipt,
# so Sway persists a minimum 31-minute reservation.
SWAY_TICKET_RESERVATION_MINUTES="31"

# Refund-only v1: an unaccepted ticket is queued for refund this many minutes
# after the event end time. Default: 24 hours.
SWAY_TICKET_REFUND_GRACE_MINUTES="1440"

# SWAY_AUDIO_STORAGE_PROVIDER: Production exact-original storage provider. Use r2 in production.
# local_private_fs is available only for local development tests.
# Leave empty to keep audio upload routes fail-closed (503).
SWAY_AUDIO_STORAGE_PROVIDER=""

# Cloudflare R2 private bucket configuration. Never expose these credentials to Vite/client code.
SWAY_AUDIO_R2_ACCOUNT_ID=""
SWAY_AUDIO_R2_ACCESS_KEY_ID=""
SWAY_AUDIO_R2_SECRET_ACCESS_KEY=""
SWAY_AUDIO_R2_BUCKET="sway-audio-originals"

# Development-only private filesystem adapter.
SWAY_AUDIO_LOCAL_OBJECT_DIR=""
SWAY_AUDIO_LOCAL_BUCKET="sway-audio-local"

# SWAY_STRIPE_CONNECT_COUNTRY: Default ISO country for new Stripe Accounts v2 recipient accounts.
SWAY_STRIPE_CONNECT_COUNTRY="US"

# SWAY_APP_BASE_URL: Canonical base URL for performer magic-link emails.
SWAY_APP_BASE_URL="http://localhost:3000"

# SWAY_EMAIL_PROVIDER: Production-only transactional email provider.
SWAY_EMAIL_PROVIDER="resend"

# SWAY_EMAIL_API_KEY: Production-only API key for the configured transactional email provider.
SWAY_EMAIL_API_KEY=""

# SWAY_EMAIL_FROM: Production-only sender address for performer sign-in links.
SWAY_EMAIL_FROM="Sway <performers@sway.tips>"

# SWAY_PERFORMER_LOGIN_RATE_LIMIT_MAX: Max performer login link requests per IP+email bucket.
SWAY_PERFORMER_LOGIN_RATE_LIMIT_MAX="3"

# SWAY_PERFORMER_LOGIN_RATE_LIMIT_WINDOW_MS: Window for performer login request rate limiting.
SWAY_PERFORMER_LOGIN_RATE_LIMIT_WINDOW_MS="600000"

# SWAY_PERFORMER_SIGNUP_RATE_LIMIT_MAX: Max performer signup requests per IP bucket.
SWAY_PERFORMER_SIGNUP_RATE_LIMIT_MAX="3"

# SWAY_PERFORMER_SIGNUP_RATE_LIMIT_WINDOW_MS: Window for performer signup request rate limiting.
SWAY_PERFORMER_SIGNUP_RATE_LIMIT_WINDOW_MS="900000"

# SWAY_PERFORMER_PASSWORD_LOGIN_RATE_LIMIT_MAX: Max failed email+password login attempts per IP+account bucket.
SWAY_PERFORMER_PASSWORD_LOGIN_RATE_LIMIT_MAX="5"

# SWAY_PERFORMER_PASSWORD_LOGIN_RATE_LIMIT_WINDOW_MS: Window for failed email+password login rate limiting.
SWAY_PERFORMER_PASSWORD_LOGIN_RATE_LIMIT_WINDOW_MS="900000"

# MUSIC_CATALOG_PROVIDER: Required before production music search can return catalog data.
MUSIC_CATALOG_PROVIDER=""
